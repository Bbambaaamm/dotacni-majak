{
  "name": "dotacni-majak",
  "private": true,
  "version": "0.0.0",
  "description": "Dotační maják — Najde. Pohlídá. Dotáhne.",
  "scripts": {
    "test:schema": "python3 scripts/validate_schemas.py",
    "test:python": "python3 -m unittest discover -s tests/python -p 'test_*.py'",
    "test": "npm run test:schema && npm run test:python",
    "generate:contracts": "python3 scripts/generate_contracts.py",
    "web:typecheck": "npm --workspace @dotacni-majak/web run typecheck",
    "web:test": "npm --workspace @dotacni-majak/web run test",
    "web:build": "npm --workspace @dotacni-majak/web run build",
    "web:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "api:typecheck": "npm --workspace @dotacni-majak/api run typecheck",
    "api:test": "npm --workspace @dotacni-majak/api run test",
    "api:build": "npm --workspace @dotacni-majak/api run build",
    "cloudflare:validate": "node scripts/validate_cloudflare_config.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm --workspace @dotacni-majak/web run dev",
    "dev:api": "npm --workspace @dotacni-majak/api run dev",
    "dev:db:migrate": "npm --workspace @dotacni-majak/api exec -- wrangler d1 migrations apply dotacni-majak-local --local --persist-to ../../.wrangler/local",
    "dev:data:refresh": "node scripts/local_refresh_nsa.mjs"
  },
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.58.2"
  }
}
