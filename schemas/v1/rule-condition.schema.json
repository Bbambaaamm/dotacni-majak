{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotacni-majak.cz/schema/v1/rule-condition.schema.json",
  "title": "RuleCondition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "ruleGroupId", "attributeDefinitionId",
    "operator", "expectedValue", "blocking", "unknownPolicy",
    "verificationStatus", "sortOrder"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "ruleGroupId": {"type": "string", "minLength": 1},
    "attributeDefinitionId": {"type": "string", "minLength": 1},
    "operator": {
      "enum": [
        "EQ", "NEQ", "IN", "NOT_IN", "LT", "LTE", "GT", "GTE",
        "BETWEEN", "EXISTS", "NOT_EXISTS", "CONTAINS", "INTERSECTS",
        "DATE_BEFORE", "DATE_AFTER", "GEO_WITHIN", "GEO_NOT_WITHIN"
      ]
    },
    "expectedValue": {},
    "blocking": {"type": "boolean"},
    "unknownPolicy": {
      "description": "UNKNOWN is never silently converted to FAIL.",
      "enum": ["PROPAGATE", "NOT_APPLICABLE"]
    },
    "evidenceId": {"type": ["string", "null"]},
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "verificationStatus": {
      "enum": [
        "AUTO_EXTRACTED", "PARTIALLY_VERIFIED", "VERIFIED", "NEEDS_REVIEW"
      ]
    },
    "sortOrder": {"type": "integer", "minimum": 0}
  }
}
