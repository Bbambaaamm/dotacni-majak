{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotacni-majak.cz/schema/v1/geography.schema.json",
  "title": "Geography",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "geographyType", "name", "countryCode"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "geographyType": {
      "enum": [
        "COUNTRY",
        "NUTS2",
        "NUTS3",
        "REGION",
        "DISTRICT",
        "ORP",
        "MUNICIPALITY",
        "MAS",
        "OTHER"
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "parentId": {"type": ["string", "null"], "minLength": 1},
    "countryCode": {"type": "string", "pattern": "^[A-Z]{2}$"},
    "code": {"type": ["string", "null"], "minLength": 1},
    "nutsCode": {"type": ["string", "null"], "minLength": 1},
    "lauCode": {"type": ["string", "null"], "minLength": 1},
    "orpCode": {"type": ["string", "null"], "minLength": 1},
    "masCode": {"type": ["string", "null"], "minLength": 1},
    "validFrom": {"type": ["string", "null"], "format": "date"},
    "validTo": {"type": ["string", "null"], "format": "date"}
  }
}
