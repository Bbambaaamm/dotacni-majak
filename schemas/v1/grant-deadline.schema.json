{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotacni-majak.cz/schema/v1/grant-deadline.schema.json",
  "title": "GrantDeadline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "grantCallVersionId", "deadlineType"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "grantCallVersionId": {"type": "string", "minLength": 1},
    "deadlineType": {"enum": ["APPLICATION_OPEN", "APPLICATION_CLOSE", "PROJECT_START", "PROJECT_FINISH", "DOCUMENT_COMPLETION", "SUSTAINABILITY_END", "OTHER"]},
    "startsAt": {"type": ["string", "null"], "format": "date-time"},
    "endsAt": {"type": ["string", "null"], "format": "date-time"},
    "timezone": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "evidenceId": {"type": ["string", "null"]}
  }
}
