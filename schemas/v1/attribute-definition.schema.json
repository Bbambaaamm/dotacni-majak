{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotacni-majak.cz/schema/v1/attribute-definition.schema.json",
  "title": "AttributeDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "key", "scope", "labelCs", "dataType",
    "filterable", "indexable", "active"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "key": {
      "type": "string",
      "pattern": "^(applicant|project)\\.[a-z][a-z0-9_.]*$"
    },
    "scope": {"enum": ["APPLICANT", "PROJECT"]},
    "labelCs": {"type": "string", "minLength": 1},
    "dataType": {
      "enum": [
        "STRING", "INTEGER", "NUMBER", "BOOLEAN", "DATE", "DATETIME",
        "MONEY_MINOR", "PERCENT_BPS", "ENUM", "GEO_ID", "STRING_SET"
      ]
    },
    "unit": {"type": ["string", "null"]},
    "resolverKey": {"type": ["string", "null"]},
    "enumValues": {
      "type": ["array", "null"],
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "filterable": {"type": "boolean"},
    "indexable": {"type": "boolean"},
    "active": {"type": "boolean"}
  }
}
