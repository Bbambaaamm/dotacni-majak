{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotacni-majak.cz/schema/v1/applicant-type.schema.json",
  "title": "ApplicantType",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "code", "nameCs", "active"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "nameCs": {"type": "string", "minLength": 1},
    "parentId": {"type": ["string", "null"], "minLength": 1},
    "active": {"type": "boolean"},
    "sortOrder": {"type": ["integer", "null"], "minimum": 0}
  }
}
