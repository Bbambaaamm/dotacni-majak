{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotacni-majak.cz/schema/v1/watch-match.schema.json",
  "title": "WatchMatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "watchId",
    "grantCallId",
    "grantCallVersionId",
    "status",
    "matchBand",
    "reasonCodes",
    "notificationCandidate",
    "dedupeKey"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "watchId": {"type": "string", "minLength": 1},
    "projectId": {"type": ["string", "null"]},
    "grantCallId": {"type": "string", "minLength": 1},
    "grantCallVersionId": {"type": "string", "minLength": 1},
    "status": {
      "enum": [
        "MATCHED",
        "NEEDS_INFORMATION",
        "NEEDS_REVIEW",
        "NOT_ELIGIBLE",
        "NOT_FINANCIALLY_COMPATIBLE",
        "NOT_RELEVANT"
      ]
    },
    "matchBand": {"enum": ["WEAK","POSSIBLE","VERY_GOOD"]},
    "relevanceScore": {"type": "number", "minimum": 0, "maximum": 1},
    "reasonCodes": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "notificationCandidate": {"type": "boolean"},
    "dedupeKey": {"type": "string", "minLength": 1}
  }
}
