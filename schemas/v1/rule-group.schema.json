{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotacni-majak.cz/schema/v1/rule-group.schema.json",
  "title": "RuleGroup",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "ruleSetId", "operator", "sortOrder"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "minLength": 1},
    "ruleSetId": {"type": "string", "minLength": 1},
    "parentGroupId": {"type": ["string", "null"]},
    "operator": {"enum": ["AND", "OR", "NOT"]},
    "sortOrder": {"type": "integer", "minimum": 0}
  }
}
