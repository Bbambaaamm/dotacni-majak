{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dotacni-majak-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "send_metrics": false,
  "vars": {
    "ENVIRONMENT": "local",
    "RELEASE_SHA": "local"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dotacni-majak-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RAW",
      "bucket_name": "dotacni-majak-raw-local"
    }
  ],
  "vectorize": [
    {
      "binding": "SEARCH",
      "index_name": "dotacni-majak-search-local"
    }
  ]
}
